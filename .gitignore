packages/
# NuGet v3 cache
.nuget/packages/

# dotnet publish
publish/
*.Publish.xml

# ASP.NET temporary files
wwwroot/node_modules/
node_modules/
npm-debug.log
yarn-error.log

# Rider / ReSharper
_ReSharper*/
*.DotSettings.user

# Visual Studio Code workspace
*.code-workspace

# Logs
*.log

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Test results
TestResults/
*.trx
*.coverage
coverage*.xml

# Database files
*.mdf
*.ldf
*.sqlite
*.db

# Certificates and secrets
*.pfx
*.key
secrets.json
appsettings.*.json

# Generated files
*.g.cs
*.g.i.cs
*.generated.cs

# Roslyn analyzer caches
*.ide.*
*.cache

# Rider caches
.idea/
.idea/*

# JetBrains Rider local history
.idea/.idea.*

# Visual Studio publish settings
*.PublishSettings

# VS Code extensions
.vscode/*

